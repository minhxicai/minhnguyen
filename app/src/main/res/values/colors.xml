<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nền sáng: trùng biến bg của :root trong assets/style.css.
         Chỉ dùng khi web đã báo theme = light (không phụ thuộc uiMode hệ thống). -->
    <color name="app_background">#F5F6FA</color>
    <!-- Nền tối: trùng biến bg của html[data-theme="dark"] trong assets/style.css.
         Chỉ dùng khi web đã báo theme = dark. -->
    <color name="app_background_dark">#0F1116</color>
    <!-- Nền tạm trước khi web kịp báo theme (lúc WebView còn đang tải tài liệu).
         Đây là màu duy nhất có biến thể values-night để khớp cài đặt hệ thống. -->
    <color name="app_background_system">#F5F6FA</color>
</resources>
